# Copy to .env (gitignored) and fill in. Credentials come from the NBA Supabase project.
# Do not hardcode these in scripts.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>   # write access (required for ingestion)
SUPABASE_ANON_KEY=<anon-key>              # read-only fallback
